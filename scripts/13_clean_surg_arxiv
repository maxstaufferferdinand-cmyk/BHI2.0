# ============================================================
# FILTER FUNCTIONS
# ============================================================

def base_reject_reason(concept: str):
    c = normalize_text(concept)
    wc = word_count(c)

    if not c:
        return "empty"

    if wc < MIN_WORDS:
        return "too_few_words"

    if wc > MAX_WORDS:
        return "too_many_words"

    if len(c) < 6:
        return "too_short"

    if re.fullmatch(r"[0-9\s]+", c):
        return "numeric_only"

    if exact_any(c, UNIVERSAL_GENERIC_EXACT):
        return "universal_generic_exact"

    if ends_with_any(c, UNIVERSAL_BAD_ENDINGS):
        return "universal_bad_ending"

    return ""


def surgery_reject_reason(concept: str, occurrence=None):
    c = normalize_text(concept)

    if contains_any(c, SURGERY_PROTECT_SUBSTRINGS):
        return ""

    base = base_reject_reason(c)
    if base:
        return base

    if exact_any(c, SURGERY_GENERIC_EXACT):
        return "surgery_generic_exact"

    if contains_any(c, SURGERY_GENERIC_SUBSTRINGS):
        return "surgery_generic_substring"

    if ends_with_any(c, SURGERY_BAD_ENDINGS):
        return "surgery_bad_ending"

    if occurrence is not None:
        try:
            occ = float(occ)
            if occ >= VERY_HIGH_SURGERY_OCCURRENCE and word_count(c) <= 3:
                return "very_high_frequency_short_surgery_term"
        except Exception:
            pass

    broad_disease_terms = {
        "colorectal cancer",
        "pancreatic cancer",
        "gastric cancer",
        "esophageal cancer",
        "liver cancer",
        "rectal cancer",
        "colon cancer",
        "hepatocellular carcinoma",
        "cholangiocarcinoma",
        "pancreatic adenocarcinoma",
    }

    if c in broad_disease_terms:
        return "broad_disease_only"

    return ""


def arxiv_reject_reason(concept: str):
    c = normalize_text(concept)

    if contains_any(c, ARXIV_PROTECT_SUBSTRINGS):
        return ""

    base = base_reject_reason(c)
    if base:
        return base

    if exact_any(c, ARXIV_GENERIC_EXACT):
        return "arxiv_generic_exact"

    if contains_any(c, ARXIV_GENERIC_SUBSTRINGS):
        return "arxiv_generic_substring"

    if ends_with_any(c, ARXIV_BAD_ENDINGS):
        return "arxiv_bad_ending"

    return ""


# ============================================================
# IO HELPERS
# ============================================================

def read_csv_flexible(path: Path) -> pd.DataFrame:
    if not path.exists():
        raise FileNotFoundError(f"Missing file: {path}")

    try:
        df = pd.read_csv(path, dtype=str).fillna("")
        if len(df.columns) == 1:
            df = pd.read_csv(path, sep=";", dtype=str).fillna("")
        return df
    except Exception:
        return pd.read_csv(path, sep=";", dtype=str).fillna("")


def standardize_columns(df):
    df = df.copy()
    df.columns = (
        df.columns
        .astype(str)
        .str.replace("\ufeff", "", regex=False)
        .str.strip()
        .str.lower()
    )
    return df


def clean_embedding_file(embedding_df: pd.DataFrame, keep_concepts: set) -> pd.DataFrame:
    if "concept" not in embedding_df.columns:
        raise ValueError(f"Embedding file missing column: concept. Columns: {embedding_df.columns.tolist()}")

    out = embedding_df.copy()
    out["concept"] = out["concept"].apply(normalize_text)
    out = out[out["concept"].isin(keep_concepts)].copy()
    out = out.drop_duplicates(subset=["concept"])
    return out


# ============================================================
# MAIN
# ============================================================

print("=" * 80)
print("CLEAN CROSSDOMAIN VOCABULARIES")
print("=" * 80)

print("Loading surgery node summary...")
surgery_nodes = read_csv_flexible(SURGERY_NODE_FILE)

print("Loading surgery embeddings...")
surgery_emb = read_csv_flexible(SURGERY_EMBEDDING_FILE)

print("Loading arXiv node summary...")
arxiv_nodes = read_csv_flexible(ARXIV_NODE_FILE)

print("Loading arXiv embeddings...")
arxiv_emb = read_csv_flexible(ARXIV_EMBEDDING_FILE)

print("\nInput sizes:")
print(f"Surgery nodes: {len(surgery_nodes)}")
print(f"Surgery embeddings: {len(surgery_emb)}")
print(f"arXiv nodes: {len(arxiv_nodes)}")
print(f"arXiv embeddings: {len(arxiv_emb)}")


# ============================================================
# STANDARDIZE COLUMN NAMES
# ============================================================

surgery_nodes = standardize_columns(surgery_nodes)
surgery_emb = standardize_columns(surgery_emb)
arxiv_nodes = standardize_columns(arxiv_nodes)
arxiv_emb = standardize_columns(arxiv_emb)

print("\nColumn check after standardization:")
print("surgery_nodes:", surgery_nodes.columns.tolist())
print("surgery_emb:", surgery_emb.columns.tolist())
print("arxiv_nodes:", arxiv_nodes.columns.tolist())
print("arxiv_emb:", arxiv_emb.columns.tolist())

for name, df_check in {
    "surgery_nodes": surgery_nodes,
    "surgery_emb": surgery_emb,
    "arxiv_nodes": arxiv_nodes,
    "arxiv_emb": arxiv_emb,
}.items():
    if "concept" not in df_check.columns:
        raise ValueError(
            f"{name} missing concept column. Columns: {df_check.columns.tolist()}"
        )


# ============================================================
# CLEAN SURGERY
# ============================================================

if "concept" not in surgery_nodes.columns:
    raise ValueError("Surgery node file missing column: concept")

surgery_nodes["concept"] = surgery_nodes["concept"].apply(normalize_text)

if "occurrence" in surgery_nodes.columns:
    surgery_nodes["occurrence"] = pd.to_numeric(surgery_nodes["occurrence"], errors="coerce").fillna(0)
else:
    surgery_nodes["occurrence"] = 0

surgery_nodes["reject_reason"] = surgery_nodes.apply(
    lambda r: surgery_reject_reason(r["concept"], r.get("occurrence", None)),
    axis=1
)

surgery_nodes["keep"] = surgery_nodes["reject_reason"].eq("")
surgery_nodes["keep"] = surgery_nodes["keep"] & (surgery_nodes["occurrence"] >= MIN_SURGERY_OCCURRENCE)

surgery_emb["concept"] = surgery_emb["concept"].apply(normalize_text)
surgery_emb_concepts = set(surgery_emb["concept"].astype(str))

surgery_nodes["has_embedding"] = surgery_nodes["concept"].isin(surgery_emb_concepts)
surgery_nodes["keep"] = surgery_nodes["keep"] & surgery_nodes["has_embedding"]

surgery_clean = surgery_nodes[surgery_nodes["keep"]].copy()
surgery_removed = surgery_nodes[~surgery_nodes["keep"]].copy()

surgery_keep_concepts = set(surgery_clean["concept"].astype(str))
surgery_emb_clean = clean_embedding_file(surgery_emb, surgery_keep_concepts)


# ============================================================
# CLEAN ARXIV
# ============================================================

if "concept" not in arxiv_nodes.columns:
    raise ValueError("arXiv node file missing column: concept")

arxiv_nodes["concept"] = arxiv_nodes["concept"].apply(normalize_text)

if "occurrence" in arxiv_nodes.columns:
    arxiv_nodes["occurrence"] = pd.to_numeric(arxiv_nodes["occurrence"], errors="coerce").fillna(0)
else:
    arxiv_nodes["occurrence"] = 0

arxiv_nodes["reject_reason"] = arxiv_nodes["concept"].apply(arxiv_reject_reason)
arxiv_nodes["keep"] = arxiv_nodes["reject_reason"].eq("")
arxiv_nodes["keep"] = arxiv_nodes["keep"] & (arxiv_nodes["occurrence"] >= MIN_ARXIV_OCCURRENCE)

arxiv_emb["concept"] = arxiv_emb["concept"].apply(normalize_text)
arxiv_emb_concepts = set(arxiv_emb["concept"].astype(str))

arxiv_nodes["has_embedding"] = arxiv_nodes["concept"].isin(arxiv_emb_concepts)
arxiv_nodes["keep"] = arxiv_nodes["keep"] & arxiv_nodes["has_embedding"]

arxiv_clean = arxiv_nodes[arxiv_nodes["keep"]].copy()
arxiv_removed = arxiv_nodes[~arxiv_nodes["keep"]].copy()

arxiv_keep_concepts = set(arxiv_clean["concept"].astype(str))
arxiv_emb_clean = clean_embedding_file(arxiv_emb, arxiv_keep_concepts)


# ============================================================
# SAVE
# ============================================================

surgery_clean = surgery_clean.sort_values(["occurrence", "concept"], ascending=[False, True])
arxiv_clean = arxiv_clean.sort_values(["occurrence", "concept"], ascending=[False, True])

surgery_removed = surgery_removed.sort_values(["reject_reason", "occurrence", "concept"], ascending=[True, False, True])
arxiv_removed = arxiv_removed.sort_values(["reject_reason", "occurrence", "concept"], ascending=[True, False, True])

surgery_clean.to_csv(SURGERY_CLEAN_FILE, index=False, encoding="utf-8-sig")
arxiv_clean.to_csv(ARXIV_CLEAN_FILE, index=False, encoding="utf-8-sig")

surgery_emb_clean.to_csv(SURGERY_EMBEDDING_CLEAN_FILE, index=False, encoding="utf-8-sig")
arxiv_emb_clean.to_csv(ARXIV_EMBEDDING_CLEAN_FILE, index=False, encoding="utf-8-sig")

surgery_removed.to_csv(REMOVED_SURGERY_FILE, index=False, encoding="utf-8-sig")
arxiv_removed.to_csv(REMOVED_ARXIV_FILE, index=False, encoding="utf-8-sig")


# ============================================================
# SUMMARY
# ============================================================

summary_lines = []

summary_lines.append("CLEAN CROSSDOMAIN VOCABULARIES SUMMARY")
summary_lines.append("=" * 60)
summary_lines.append("")
summary_lines.append(f"Surgery input nodes: {len(surgery_nodes)}")
summary_lines.append(f"Surgery kept concepts: {len(surgery_clean)}")
summary_lines.append(f"Surgery removed concepts: {len(surgery_removed)}")
summary_lines.append(f"Surgery clean embeddings: {len(surgery_emb_clean)}")
summary_lines.append("")
summary_lines.append(f"arXiv input nodes: {len(arxiv_nodes)}")
summary_lines.append(f"arXiv kept concepts: {len(arxiv_clean)}")
summary_lines.append(f"arXiv removed concepts: {len(arxiv_removed)}")
summary_lines.append(f"arXiv clean embeddings: {len(arxiv_emb_clean)}")
summary_lines.append("")
summary_lines.append("Top surgery removed reasons:")
summary_lines.append(str(surgery_removed["reject_reason"].value_counts().head(20)))
summary_lines.append("")
summary_lines.append("Top arXiv removed reasons:")
summary_lines.append(str(arxiv_removed["reject_reason"].value_counts().head(20)))
summary_lines.append("")
summary_lines.append("Top kept surgery concepts:")
if len(surgery_clean) > 0:
    summary_lines.append(str(surgery_clean[["concept", "occurrence"]].head(30)))
else:
    summary_lines.append("No surgery concepts kept.")
summary_lines.append("")
summary_lines.append("Top kept arXiv concepts:")
if len(arxiv_clean) > 0:
    summary_lines.append(str(arxiv_clean[["concept", "occurrence"]].head(30)))
else:
    summary_lines.append("No arXiv concepts kept.")

SUMMARY_FILE.write_text("\n".join(summary_lines), encoding="utf-8")

print("\n" + "=" * 80)
print("DONE")
print("=" * 80)
print(f"Saved: {SURGERY_CLEAN_FILE}")
print(f"Saved: {ARXIV_CLEAN_FILE}")
print(f"Saved: {SURGERY_EMBEDDING_CLEAN_FILE}")
print(f"Saved: {ARXIV_EMBEDDING_CLEAN_FILE}")
print(f"Saved: {REMOVED_SURGERY_FILE}")
print(f"Saved: {REMOVED_ARXIV_FILE}")
print(f"Saved: {SUMMARY_FILE}")

print("\nSummary:")
print("\n".join(summary_lines[:12]))